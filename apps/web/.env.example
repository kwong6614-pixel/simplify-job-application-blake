DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Vercel: use transaction pooler port 6543 with pgbouncer=true, e.g.
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
AUTH_SECRET="replace-with-openssl-rand-hex-32"
NEXTAUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_SHEETS_ID=""
GOOGLE_REFRESH_TOKEN=""
# Optional sheet tabs (comma-separated). Defaults to "For Resume, All Jobs"
# GOOGLE_SHEET_TAB_NAMES="For Resume, All Jobs"
# Or sync a single tab:
# GOOGLE_SHEET_TAB_NAME="For Resume"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Password reset emails (Resend) — required on Vercel/production
# 1. Create API key: https://resend.com/api-keys
# 2. Verify your domain: https://resend.com/domains
# 3. Use a verified sender, e.g. JobApply <noreply@yourdomain.com>
# Dev/testing only: Resend sandbox sender onboarding@resend.dev (delivers to your Resend account email)
RESEND_API_KEY=""
EMAIL_FROM="JobApply <noreply@yourdomain.com>"
# Optional
EMAIL_REPLY_TO="support@yourdomain.com"
APP_NAME="JobApply"
